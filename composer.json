        }
    ],
    "require": {
        "slim/slim": "^4",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "predis/predis": "^3.5",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
