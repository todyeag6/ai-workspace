{
    "name": "aiwebscapes/platform",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Aiwebscapes Dev",
            "email": "dev@aiwebscapes.local"
        }
    ],
    "require": {
        "php": "^8.3",
        "slim/slim": "^4",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "predis/predis": "^3.5",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "cyclonedx/cyclonedx-php-composer": "^6.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true,
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse"
    }
}
