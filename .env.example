# Copy to .env and fill in locally. NEVER commit a real .env.
# All values here are intentionally empty — this file documents keys only.

# PDO DSN for the application database
DB_DSN=

# PDO DSN for the test database
TEST_DB_DSN=

# Redis connection DSN
REDIS_DSN=

# Base URL for the local OpenAI-compatible AI endpoint (Ollama on the host)
AI_LOCAL_BASE_URL=

# --- Required by legacy/config/app.php (FR-CONF-002: boot fails if unset) ---

# Long random secret used to hash client IPs (security.ip_hash_secret)
APP_KEY=

# Database hostname for the legacy PDO connection
DB_HOST=

# Database schema name
DB_NAME=

# Database username
DB_USER=

# Database password
DB_PASSWORD=

# --- Optional tunables (legacy/config/app.php falls back to a safe default) ---

# Display name of the application (default: Aiwebscapes)
APP_NAME=

# Deployment environment: production | staging | local (default: production)
APP_ENV=

# Public base URL (default: https://aiwebscapes.com)
APP_BASE_URL=

# Support contact address (default: support@aiwebscapes.com)
APP_SUPPORT_EMAIL=

# Owner/admin contact address (default: admin@aiwebscapes.com)
APP_OWNER_EMAIL=

# MySQL connection charset (default: utf8mb4)
DB_CHARSET=

# Lifetime of a CSRF token in seconds (default: 1800)
CSRF_TTL_SECONDS=

# Idle session lifetime in seconds (default: 1800)
SESSION_TTL_SECONDS=

# Rate-limit sliding window in seconds (default: 300)
RATE_LIMIT_WINDOW_SECONDS=

# Max attempts allowed inside the rate-limit window (default: 5)
RATE_LIMIT_MAX_ATTEMPTS=
